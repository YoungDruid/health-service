  "item": [
    {
      "name": "Create User",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const suffix = Date.now();",
              "",
              "pm.collectionVariables.set(",
              "    \"username\",",
              "    \"user_\" + suffix",
              ");",
              "",
              "pm.collectionVariables.set(",
              "    \"email\",",
              "    \"user_\" + suffix + \"@example.com\"",
              ");"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.expect(json.id).to.exist;",
              "pm.expect(json.username).to.eql(",
              "    pm.collectionVariables.get(\"username\")",
              ");",
              "",
              "pm.collectionVariables.set(\"userId\", json.id);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"firstName\": \"Nurym\",\n  \"lastName\": \"Test\",\n  \"email\": \"{{email}}\",\n  \"phone\": \"+77001234567\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/user",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "user"
          ]
        }
      },
      "response": []
    },
