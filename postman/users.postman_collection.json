              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.expect(json.id).to.eql(",
              "    Number(pm.collectionVariables.get(\"userId\"))",
              ");",
              "",
              "pm.expect(json.username).to.eql(",
